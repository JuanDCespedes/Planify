{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "editor.formatOnSave": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "files.exclude": {
      "**/__pycache__": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python"
    ]
  }
}
