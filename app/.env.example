PLANIFY_ENV=production
PLANIFY_SECRET_KEY=replace-with-a-random-secret-before-starting
PLANIFY_DATABASE_URL=sqlite:////data/planify.db
PLANIFY_RATE_LIMIT_STORAGE_URI=memory://
PLANIFY_TIMEZONE=America/Bogota
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: leave blank to use the request host's /auth/google/callback URL.
GOOGLE_REDIRECT_URI=

# Optional browser push. Generate a matching private/public pair with:
# python -c "from planify.infrastructure.notification_delivery import generate_vapid_keys; print(*generate_vapid_keys(), sep='\n')"
PLANIFY_VAPID_PRIVATE_KEY=
PLANIFY_VAPID_PUBLIC_KEY=
PLANIFY_VAPID_CLAIMS_EMAIL=

# Optional weekly digest email (sent Mondays after 09:00 local server time).
PLANIFY_SMTP_HOST=
PLANIFY_SMTP_PORT=587
PLANIFY_SMTP_USERNAME=
PLANIFY_SMTP_PASSWORD=
PLANIFY_SMTP_FROM=
PLANIFY_SMTP_USE_SSL=false
PLANIFY_SMTP_STARTTLS=true

# Runs one scheduler in this application process. Disable if a separate scheduler is used.
PLANIFY_ENABLE_NOTIFICATION_SCHEDULER=true
